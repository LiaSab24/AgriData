# Das Bild-Archiv wird in diesem Repository BEWUSST versioniert:
# GitHub Actions laedt die DWD-Karten und committet sie, das Repo ist das
# Archiv. Deshalb ist public/images/ hier - anders als in AgriDataDWD -
# nicht ignoriert.
#
# Runtime-Artefakte, die weiterhin nicht ins Repo gehoeren:
data/*
logs/*
!data/.gitkeep
!logs/.gitkeep

# custom config files
config/*.local.js
claudedoc.md

# Claude Code – maschinenlokale Einstellungen
# (settings.json, skills/, agents/ bewusst NICHT ignoriert – die duerfen ins Repo)
.claude/settings.local.json

# macOS
._*
.Spotlight-V100
.Trashes

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Tool-Caches
*.tsbuildinfo
.eslintcache
.npm
dist-ssr
*.local
