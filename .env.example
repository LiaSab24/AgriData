# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEATHER DATA CONFIG
BF_SCHLUF_CRON="0 16 * * *"
BF_SAND_CRON="0 16 * * *"
BT_DE_CRON="0 16 */5 * * "
BF_SH_CRON="0 16 */10 * *"
BT_SH_CRON="0 16 */10 * *"
MONTHLY_DATA_CRON="0 16 1 * *"
RETRY_COUNT=3
TIMEOUT_MS=60000
SCREENSHOT_WIDTH=1920
SCREENSHOT_HEIGHT=1080
LOG_LEVEL="info"
HEADLESS="true"
